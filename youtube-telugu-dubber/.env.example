# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Model Configuration
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_MODEL=eleven_v3

# Audio Settings
AUDIO_SPEED=1.0  # 1.0=normal, 1.6=faster, 0.8=slower

# Optional: Eleven Labs Voice ID (defaults to a multilingual voice)
ELEVENLABS_VOICE_ID=
